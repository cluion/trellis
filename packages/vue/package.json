{
    "name": "@trellisjs/vue",
    "version": "0.1.0",
    "description": "Trellis 的 Vue 3 適配器 — 無頭式資料表格元件",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean": "rm -rf dist *.tsbuildinfo"
    },
    "peerDependencies": {
        "@trellisjs/core": "workspace:^",
        "vue": ">=3.5.0"
    },
    "devDependencies": {
        "@trellisjs/core": "workspace:*",
        "@trellisjs/plugin-column-pinning": "workspace:*",
        "@trellisjs/plugin-column-resizing": "workspace:*",
        "@trellisjs/plugin-pagination": "workspace:*",
        "@trellisjs/plugin-row-expansion": "workspace:*",
        "@trellisjs/plugin-virtual-scroll": "workspace:*",
        "@vue/test-utils": "^2.5.1",
        "jsdom": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "vue": "^3.5.44"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/cluion/trellis.git",
        "directory": "packages/vue"
    },
    "license": "MIT",
    "sideEffects": false
}
