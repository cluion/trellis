generator client {
  provider     = "prisma-client"
  output       = "../generated/client"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int    @id
  name         String
  email        String
  privateField String

  @@map("trellis_user")
}

model SqlRow {
  id          Int    @id
  orderValue  String @map("order")
  groupValue  String @map("group")
  selectValue String @map("select")

  @@map("trellis_sql_row")
}
