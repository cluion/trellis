{
    "name": "trellis-monorepo",
    "private": true,
    "description": "Trellis — 現代化、無頭式、插件導向的資料表格庫",
    "scripts": {
        "build": "pnpm -r --stream run build",
        "test": "pnpm -r --stream run test",
        "test:watch": "pnpm -r --parallel run test:watch",
        "clean": "pnpm -r run clean && rm -rf node_modules",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "pnpm -r build && changeset publish",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "types:check": "pnpm -r --stream exec tsc --noEmit",
        "audit:dependencies": "pnpm audit",
        "ci:check": "pnpm build && pnpm lint:check && pnpm format:check && pnpm types:check && pnpm test"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "packageManager": "pnpm@9.15.4",
    "devDependencies": {
        "@changesets/changelog-github": "^0.6.0",
        "@changesets/cli": "^2.30.0",
        "@eslint/js": "^9.39.5",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@vitest/coverage-v8": "^4.1.12",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.9.10",
        "typescript": "catalog:",
        "typescript-eslint": "^8.71.2"
    },
    "pnpm": {
        "auditConfig": {
            "ignoreGhsas": [
                "GHSA-vfj7-8cjw-p6xm",
                "GHSA-hp3w-g68c-fv3c",
                "GHSA-g7r4-m6w7-qqqr"
            ]
        }
    }
}
